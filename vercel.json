{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,

  "//": "SHORT LINK for asking a customer for a review face to face or by text: chaneyspressurewashing.com/review. /reviews is here because people say it both ways. Deliberately NOT permanent — a 301 is cached in the customer's browser forever, so if the Google listing is ever recreated and the place ID changes, anyone who used the old link keeps landing on the wrong business with no way to clear it. A 307 costs nothing and stays fixable.",
  "redirects": [
    {
      "source": "/review(s)?",
      "destination": "https://search.google.com/local/writereview?placeid=ChIJ03ljkkPl7IgRjE0BMG9oFt4",
      "permanent": false
    }
  ],

  "headers": [
    {
      "source": "/assets/(fonts|img)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    }
  ]
}
